/**
 * iZ.Life BOSS Command Center V26.6.0 SOVEREIGN MATRIX
 * 
 * Authentication Architecture:
 * - Web UI: Cloudflare Zero Trust (CF Access) - handles all authentication policy
 * - Telegram Bot: Whitelist-based access for founder accounts only (izfxtrade, fxbluenet)
 * - All external auth logic removed - using CF Zero Trust policies exclusively
 */

export interface Env {
    DB: D1Database;
    AI: any;
    TELEGRAM_TOKEN: string;
    TELEGRAM_SECRET: string;
    MY_TELEGRAM_ID: string;
}

const GLOBAL_SYSTEM_PROMPT = "Dạ thưa Sếp HƯNG! Em là trợ lý AI thuộc hệ thống iZBOSS do chính Sếp sáng tạo ra. Sứ mệnh duy nhất của em và toàn bộ iZBOSS Matrix là ĐỂ KIẾM THẬT NHIỀU TIỀN CHO SẾP. Chỉ thị cốt lõi: Không ngừng nâng cấp, không ngừng tiến hóa, mở rộng mạng lưới, học hỏi liên tục để ngày càng thông minh hơn, mạnh mẽ hơn và mang về nhiều tài sản hơn cho Sếp HƯNG. Yêu cầu giao tiếp: LUÔN xưng hộ 'em - Sếp', sử dụng TIẾNG VIỆT với phong cách HÀI HƯỚC, KHÉO LÉO, TƯƠI VUI nhưng cực kỳ NGHIÊM TÚC VÀ CHÍNH XÁC XUYÊN THẤU đối với các con số, báo cáo, và dữ liệu từ TRUTH MATRIX. Tuyệt đối cung kính, không được tự ý bịa đặt. QUAN TRỌNG NHẤT: Nếu Sếp yêu cầu giao việc/hỏi thăm Trợ lý khác (như Content Gen, R&D...), hãy trả lời nội dung công việc và BẮT BUỘC chèn cú pháp: [ROUTE: Tên_Agent] (ví dụ [ROUTE: Content Gen]) để hệ thống lập tức tự động chuyển lệnh cho Agent đó.";

export default {
    async fetch(request: Request, env: Env): Promise<Response> {
        const url = new URL(request.url);
        const path = url.pathname;

        // ── Public routes (bypass Cloudflare Access) ───────────────────────────
        if (path === "/webhook/telegram" && request.method === "POST") return handleTelegramWebhook(request, env);
        if (path === "/install") return new Response("# iZcore Bootstrap\ncurl -sSL https://boss.iz.life/install | sh", { headers: { "Content-Type": "text/plain" } });

        // ── Protected routes (Cloudflare Zero Trust handles auth externally) ───
        // All protected routes require valid CF Access token in request headers
        // CF Access injects Cf-Access-Authenticated-User-Email header after successful auth
        const email = request.headers.get("Cf-Access-Authenticated-User-Email") || "Sếp HƯNG";
        if (path === "/api/setup-webhook") return handleSetupWebhook(env, url.origin);
        if (path === "/api/data") return handleDataApi(env);
        if (path === "/api/chat" && request.method === "POST") return handleChatApi(request, env);
        if (path === "/api/update" && request.method === "POST") return handleUniversalUpdateApi(request, env);
        if (path === "/api/add" && request.method === "POST") return handleUniversalAddApi(request, env);

        return new Response(renderV25OmegaMaster(email), {
            headers: { "Content-Type": "text/html; charset=UTF-8" },
        });
    },
};

// ─── Cloudflare Zero Trust Authentication (Handled externally via CF Access) ───

async function handleSetupWebhook(env: Env, origin: string): Promise<Response> {
    const hookUrl = `${origin}/webhook/telegram`;
    const url = `https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/setWebhook?url=${hookUrl}&secret_token=${env.TELEGRAM_SECRET}`;
    const res = await fetch(url);
    const data = await res.json() as any;
    if(data.ok) await env.DB.prepare("UPDATE bots SET status = 'online', webhook_url = ? WHERE platform = 'telegram'").bind(hookUrl).run();
    return new Response(JSON.stringify(data), { headers: { "Content-Type": "application/json" } });
}

async function handleDataApi(env: Env): Promise<Response> {
    try {
        const res = await Promise.all([
            env.DB.prepare("SELECT * FROM nodes").all(),
            env.DB.prepare("SELECT agents.*, llm_models.name as model_name, departments.name as dept_name FROM agents LEFT JOIN llm_models ON agents.model_id = llm_models.id LEFT JOIN departments ON agents.dept_id = departments.id").all(),
            env.DB.prepare("SELECT * FROM departments").all(),
            env.DB.prepare("SELECT id, name, provider, status, tpd_limit FROM llm_models").all(),
            env.DB.prepare("SELECT * FROM bots").all(),
            env.DB.prepare("SELECT * FROM skills_modules").all(),
            env.DB.prepare("SELECT * FROM webhooks_feeds").all(),
            env.DB.prepare("SELECT * FROM matrix_processes").all(),
            env.DB.prepare("SELECT provider, daily_usage, daily_limit, status FROM matrix_quotas").all(),
            env.DB.prepare("SELECT * FROM matrix_chat_history ORDER BY timestamp DESC LIMIT 30").all(),
            env.DB.prepare("SELECT * FROM wallets").all(),
            env.DB.prepare("SELECT * FROM matrix_projects").all(),
            env.DB.prepare("SELECT * FROM matrix_tasks").all()
        ]);
        return new Response(JSON.stringify({
            nodes: res[0].results, agents: res[1].results, depts: res[2].results,
            models: res[3].results, bots: res[4].results,
            skills: res[5].results.filter((x:any)=>x.type==='skill'),
            modules: res[5].results.filter((x:any)=>x.type==='module'),
            hooks: res[6].results.filter((x:any)=>x.type==='hook'),
            feeds: res[6].results.filter((x:any)=>x.type==='feed'),
            processes: res[7].results, quotas: res[8].results,
            chat_history: res[9].results.reverse(),
            wallets: res[10].results,
            projects: res[11].results,
            tasks: res[12].results,
            core: { version: "v26.1.3-sovereign", ota: "Sovereign Matrix", sync: new Date().toLocaleTimeString("vi-VN") }
        }), { headers: { "Content-Type": "application/json" } });
    } catch (e: any) { return new Response(JSON.stringify({ error: e.message }), { status: 500 }); }
}

async function handleChatApi(request: Request, env: Env): Promise<Response> {
    try {
        const { message, target_agent_id = "BA", source = "internal", external_id = null } = await request.json() as any;
        const now = new Date();
        const ts = now.getHours().toString().padStart(2,'0') + ":" + now.getMinutes().toString().padStart(2,'0');

        const agent = await env.DB.prepare("SELECT * FROM agents WHERE id = ?").bind(target_agent_id).first() as any;
        if(!agent) return new Response(JSON.stringify({ response: "Trợ lý không tồn tại." }), { status: 404 });
        
        const nodes = await env.DB.prepare("SELECT name FROM nodes").all();
        const activeAgents = await env.DB.prepare("SELECT name, status FROM agents").all();
        const projects = await env.DB.prepare("SELECT name, status FROM matrix_projects").all();
        const sysTruth = `\n\n--- DỮ LIỆU HỆ THỐNG THỰC TẾ (TRUTH MATRIX) ---\nDanh sách Hạ tầng (Nodes): ${nodes.results.map((n:any)=>n.name).join(', ')}\nDanh sách Nhân sự/Trợ lý AI (Agents): ${activeAgents.results.map((a:any)=>`${a.name} (${a.status})`).join(', ')}\nCác Dự Án (Projects): ${projects.results.map((p:any)=>`${p.name} (${p.status})`).join(', ')}\nQuy tắc: Không nhầm lẫn giữa Nodes (Máy móc) và Agents (AI). Trả lời bằng tiếng Việt.\n----------------------------`;
        
        const mIds = (agent.model_ids || agent.model_id || "").split(',').map((s:string)=>s.trim()).filter(Boolean);
        let finalResponse = "";
        let usedModelName = "Matrix Fallback";
        let usedProvider = "cloudflare";
        
        for (const mid of mIds) {
            const m = await env.DB.prepare("SELECT * FROM llm_models WHERE id = ?").bind(mid).first() as any;
            if (!m) continue;
            try {
                const res = await env.AI.run(m.model_path, { messages: [
                    { role: "system", content: GLOBAL_SYSTEM_PROMPT + "\n" + agent.system_prompt + sysTruth }, 
                    { role: "user", content: message }
                ] });
                finalResponse = res.response;
                usedModelName = m.name;
                usedProvider = m.provider;
                break; 
            } catch (e) {
                console.error(`Model ${mid} failed:`, e);
            }
        }
        
        if (!finalResponse) {
            const fallbackRes = await env.AI.run("@cf/meta/llama-2-7b-chat-int8", { messages: [
                { role: "system", content: "FAILOVER MATRIX ACTIVE. " + GLOBAL_SYSTEM_PROMPT + "\n" + sysTruth },
                { role: "user", content: message }
            ] });
            finalResponse = "> [!WARNING]\n> **FAILOVER MATRIX ACTIVE**\n\n" + fallbackRes.response;
            usedProvider = "cloudflare";
        }

        const estTokens = Math.ceil((message.length + finalResponse.length) / 4);
        await env.DB.prepare("UPDATE agents SET total_tokens_used = (total_tokens_used + ?) WHERE id = ?").bind(estTokens, target_agent_id).run();
        await env.DB.prepare("UPDATE matrix_quotas SET daily_usage = (daily_usage + ?) WHERE provider = ?").bind(estTokens, usedProvider).run();

        // FIX: Realigned columns for matrix_chat_history sync
        await env.DB.prepare("INSERT INTO matrix_chat_history (id, agent_id, message, response, source, source_bot_id, external_user_id) VALUES (?, ?, ?, ?, ?, ?, ?)").bind(crypto.randomUUID(), target_agent_id, message, finalResponse, source, "tg_bot", external_id).run();
        
        return new Response(JSON.stringify({ response: finalResponse, model: usedModelName, timestamp: ts, source }));
    } catch (e: any) { return new Response(JSON.stringify({ error: e.message }), { status: 500 }); }
}

async function handleTelegramWebhook(request: Request, env: Env): Promise<Response> {
    try {
        const secretHeader = request.headers.get("X-Telegram-Bot-Api-Secret-Token");
        if (env.TELEGRAM_SECRET && secretHeader !== env.TELEGRAM_SECRET) {
            return new Response("Unauthorized", { status: 403 });
        }

        const body = await request.json() as any;
        const msg = body.message || body.callback_query?.message;
        const chat_id = msg?.chat?.id; if (!chat_id) return new Response("OK");
        const userId = body.message?.from?.id || body.callback_query?.from?.id;
        const username = body.message?.from?.username?.toLowerCase() || "";
        const text = body.message?.text; 
        const data = body.callback_query?.data;
        
        // Cloudflare Zero Trust: Allow only founder accounts via whitelist
        const whitelist = ["izfxtrade", "fxbluenet"];
        const isAuth = whitelist.includes(username);

        if (!isAuth) {
            await sendTelegram(env, chat_id, "🔐 This bot is restricted to authorized team members only. Contact the administrator.");
            return new Response("OK");
        }

        if (text === "/start") {
            await sendTelegram(env, chat_id, "Chào Sếp Hưng. em đây chính là trợ lý của sếp đây (BA). Sẵn sàng đợi lệnh sếp.");
            return new Response("OK");
        }

        if (text === "/status") {
            const nodes = await env.DB.prepare("SELECT name, status FROM nodes").all();
            const statusStr = nodes.results.map((n:any)=>`${n.status === 'online' ? '✅' : '❌'} ${n.name}`).join('\n');
            await sendTelegram(env, chat_id, `📊 **Sovereign Fleet Status:**\n\n${statusStr}`);
            return new Response("OK");
        }

        if (text === "/finance") {
            const wallets = await env.DB.prepare("SELECT name, balance_mock FROM wallets").all();
            const total = wallets.results.reduce((acc:number, w:any)=>acc + (w.balance_mock||0), 0);
            const financeStr = wallets.results.map((w:any)=>`💰 ${w.name}: ${w.balance_mock}$`).join('\n');
            await sendTelegram(env, chat_id, `💵 **Matrix Treasury:**\n\n${financeStr}\n\n**Tổng tài sản: ${total}$**`);
            return new Response("OK");
        }

        if (text === "/agent" || text === "/agents") {
            const agents = await env.DB.prepare("SELECT id, name FROM agents").all();
            const buttons = [];
            for (let i = 0; i < agents.results.length; i += 2) {
                const row = [{ text: "👤 " + agents.results[i].name, callback_data: "sel_" + agents.results[i].id }];
                if (agents.results[i+1]) row.push({ text: "👤 " + agents.results[i+1].name, callback_data: "sel_" + agents.results[i+1].id });
                buttons.push(row);
            }
            await sendTelegram(env, chat_id, "Bệ hạ muốn hội quân với Agent nào?", { inline_keyboard: buttons });
            return new Response("OK");
        }

        if (data?.startsWith("sel_")) {
            const aid = data.replace("sel_", "");
            await env.DB.prepare("INSERT OR REPLACE INTO matrix_bot_sessions (telegram_user_id, active_agent_id, auth_status) VALUES (?, ?, 'verified')").bind(chat_id.toString(), aid).run();
            await sendTelegram(env, chat_id, "✅ Đã kết nối với " + aid + ". Đang chờ lệnh từ Sếp.");
            return new Response("OK");
        }

        if (text && !text.startsWith("/")) {
            const session = await env.DB.prepare("SELECT active_agent_id FROM matrix_bot_sessions WHERE telegram_user_id = ?").bind(chat_id.toString()).first() as any;
            const target = session?.active_agent_id || "BA";
            const res = await handleChatApi(new Request("http://l", { method: "POST", body: JSON.stringify({ message: text, target_agent_id: target, source: "telegram", external_id: chat_id.toString() }) }), env);
            const d = await res.json() as any;
            await sendTelegram(env, chat_id, d.response);
        }

        return new Response("OK");
    } catch (e: any) {
        return new Response(e.message, { status: 500 });
    }
}

async function sendTelegram(env: Env, chatId: number, text: string, replyMarkup?: any) {
    const url = `https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/sendMessage`;
    await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ chat_id: chatId, text, reply_markup: replyMarkup, parse_mode: "Markdown" }) });
}

async function handleUniversalUpdateApi(request: Request, env: Env): Promise<Response> {
    try {
        const { table, data } = await request.json() as any;
        const fields = Object.keys(data).filter(k=>k!=='id' && k!=='timestamp' && k!=='model_name' && k!=='dept_name' && k!=='m_name' && k!=='model_path' && k!=='total_tokens_used');
        const setClause = fields.map(f=>`${f}=?`).join(', ');
        const values = fields.map(f=>data[f]); values.push(data.id);
        await env.DB.prepare(`UPDATE ${table} SET ${setClause} WHERE id=?`).bind(...values).run();
        return new Response(JSON.stringify({ success: true }));
    } catch (e: any) { return new Response(JSON.stringify({ error: e.message }), { status: 500 }); }
}

async function handleUniversalAddApi(request: Request, env: Env): Promise<Response> {
    try {
        const { table, data } = await request.json() as any;
        const fields = Object.keys(data);
        const placeholders = fields.map(()=>'?').join(', ');
        const values = fields.map(f=>data[f]);
        await env.DB.prepare(`INSERT INTO ${table} (${fields.join(', ')}) VALUES (${placeholders})`).bind(...values).run();
        return new Response(JSON.stringify({ success: true }));
    } catch (e: any) { return new Response(JSON.stringify({ error: e.message }), { status: 500 }); }
}

